{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "meridius-nova",
	"version": "0.1.0",
	"identifier": "com.infinite.meridius",
	"build": {
		"frontendDist": "http://localhost:3001",
		"devUrl": "http://localhost:3000",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build:windows"
	},
	"app": {
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"nsis"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [
			"resources/.output",
			"resources/i18n"
		],
		"externalBin": [
			"binaries/server"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "{{TAURI_PUBLIC_KEY}}",
			"endpoints": [
				"https://api.github.com/repos/{{REPO_OWNER}}/{{REPO_NAME}}/releases/latest"
			]
		}
	}
}